cabal-version:      3.0
name:               memory-cache
version:            1.0.0.0
synopsis:           In-memory LRU cache
description:        In-memory LRU cache for storing results of monadic actions.
homepage:           https://github.com/scrive/memory-cache
license:            BSD-3-Clause
license-file:       LICENSE
author:             Scrive AB
maintainer:         Andrzej Rybczak <andrzej@rybczak.net>
copyright:          Scrive AB
category:           Data
build-type:         Simple
tested-with:        GHC ^>= { 8.10, 9.0, 9.2, 9.4, 9.6, 9.8, 9.10, 9.12, 9.14 }
extra-doc-files:    CHANGELOG.md

bug-reports:   https://github.com/scrive/memory-cache/issues
source-repository head
  type:             git
  location:         https://github.com/scrive/memory-cache.git

common language
  ghc-options: -Wall -Wextra -Werror=prepositive-qualified-module

  default-language: Haskell2010

  default-extensions: DerivingStrategies
                    , FlexibleContexts
                    , FlexibleInstances
                    , GeneralizedNewtypeDeriving
                    , LambdaCase
                    , ImportQualifiedPost
                    , NumericUnderscores
                    , ScopedTypeVariables
                    , TupleSections
                    , TypeApplications
                    , UndecidableInstances

library
  import:           language

  exposed-modules:  Data.MemCache
                    Data.MemCache.Internal

  build-depends:    base >= 4.14 && < 5
                  , deepseq >= 1.4.3.0
                  , hashable >= 1.4.3.0
                  , monad-control >= 1.0.3
                  , psqueues >= 0.2.7.0
                  , strict-mutable-base >= 2.0.0.0 && < 3
                  , transformers >= 0.5.6
                  , transformers-base >= 0.4.6
                  , unordered-containers >= 0.2.18

  hs-source-dirs:   src

test-suite test
  import:           language

  ghc-options:      -threaded -rtsopts -with-rtsopts=-N

  build-depends:    base
                  , async
                  , memory-cache
                  , tasty
                  , tasty-hunit
                  , transformers

  hs-source-dirs:   tests

  type:             exitcode-stdio-1.0
  main-is:          Main.hs

  other-modules:    Data.MemCache.Test.Class
                    Data.MemCache.Test.Concurrency
                    Data.MemCache.Test.Helpers
                    Data.MemCache.Test.Storage
                    Data.MemCache.Test.Transformers
